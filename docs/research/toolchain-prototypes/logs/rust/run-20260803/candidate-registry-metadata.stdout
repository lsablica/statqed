serde #serde #serialization #no_std
A generic serialization/deserialization framework
version: 1.0.229
license: MIT OR Apache-2.0
rust-version: 1.56
documentation: https://docs.rs/serde
homepage: https://serde.rs
repository: https://github.com/serde-rs/serde
crates.io: https://crates.io/crates/serde/1.0.229
features:
 +default      = [std]
  std          = [serde_core/std]
  alloc        = [serde_core/alloc]
  derive       = [serde_derive]
  rc           = [serde_core/rc]
  serde_derive = [dep:serde_derive]
  unstable     = [serde_core/unstable]
serde_json #json #serde #serialization
A JSON serialization file format
version: 1.0.151
license: MIT OR Apache-2.0
rust-version: 1.71
documentation: https://docs.rs/serde_json
repository: https://github.com/serde-rs/json
crates.io: https://crates.io/crates/serde_json/1.0.151
features:
 +default             = [std]
  std                 = [memchr/std, serde_core/std]
  alloc               = [serde_core/alloc]
  arbitrary_precision = []
  float_roundtrip     = []
  indexmap            = [dep:indexmap]
  preserve_order      = [indexmap, std]
  raw_value           = []
  unbounded_depth     = []
arrow #arrow
Rust implementation of Apache Arrow
version: 59.1.0
license: Apache-2.0
rust-version: 1.85
documentation: https://docs.rs/arrow/59.1.0
homepage: https://github.com/apache/arrow-rs
repository: https://github.com/apache/arrow-rs
crates.io: https://crates.io/crates/arrow/59.1.0
features:
 +default                   = [csv, ipc, json]
  arrow-csv                 = [dep:arrow-csv]
  arrow-ipc                 = [dep:arrow-ipc]
  arrow-json                = [dep:arrow-json]
  csv                       = [arrow-csv]
  ipc                       = [arrow-ipc]
  json                      = [arrow-json]
  async                     = [arrow-array/async]
  canonical_extension_types = [arrow-schema/canonical_extension_types]
  chrono-tz                 = [arrow-array/chrono-tz]
  ffi                       = [arrow-schema/ffi, arrow-data/ffi, arrow-array/ffi]
  force_validate            = [arrow-array/force_validate, arrow-data/force_validate]
  ipc_compression           = [ipc, arrow-ipc/lz4, arrow-ipc/zstd]
  pool                      = [arrow-array/pool]
  prettyprint               = [arrow-cast/prettyprint]
  pyarrow                   = [ffi, dep:arrow-pyarrow]
  test_utils                = [dep:rand, dep:half]
zip #zip #archive #compression
Library to support the reading and writing of zip files.
version: 7.2.0 (latest 9.0.0-pre2)
license: MIT
rust-version: 1.83.0
documentation: https://docs.rs/zip/7.2.0
repository: https://github.com/zip-rs/zip2.git
crates.io: https://crates.io/crates/zip/7.2.0
features:
 +default                       = [aes-crypto, bzip2, deflate64, deflate, lzma, ppmd, time, zstd, xz]
  _bzip2_any                    = []
  _deflate-any                  = []
  aes-crypto                    = [dep:aes, dep:constant_time_eq, dep:generic-array, getrandom/std, dep:hmac, dep:pbkdf2, dep:sha1, dep:zeroize]
  bzip2                         = [dep:bzip2, bzip2/default, _bzip2_any]
  deflate                       = [deflate-zopfli, deflate-flate2-zlib-rs]
  deflate-flate2                = [_deflate-any, dep:flate2]
  deflate-flate2-zlib-rs        = [deflate-flate2, flate2/zlib-rs]
  deflate-zopfli                = [dep:zopfli, _deflate-any]
  deflate64                     = [dep:deflate64]
  lzma                          = [dep:lzma-rust2]
  ppmd                          = [dep:ppmd-rust]
  time                          = [dep:time]
  xz                            = [dep:lzma-rust2]
  zstd                          = [dep:zstd]
  _all-features                 = []
  _arbitrary                    = [dep:arbitrary]
  bitstream-io                  = [dep:bitstream-io]
  bzip2-rs                      = [dep:bzip2, bzip2/bzip2-sys, _bzip2_any]
  chrono                        = [dep:chrono]
  deflate-flate2-zlib           = [deflate-flate2, flate2/zlib]
  deflate-flate2-zlib-ng        = [deflate-flate2, flate2/zlib-ng]
  deflate-flate2-zlib-ng-compat = [deflate-flate2, flate2/zlib-ng-compat]
  getrandom                     = [dep:getrandom]
  jiff-02                       = [dep:jiff]
  legacy-zip                    = [bitstream-io]
  nt-time                       = [dep:nt-time]
  unreserved                    = []
zip #zip #archive #compression
Library to support the reading and writing of zip files.
version: 8.1.0 (latest 9.0.0-pre2)
license: MIT
rust-version: 1.88
documentation: https://docs.rs/zip/8.1.0
repository: https://github.com/zip-rs/zip2.git
crates.io: https://crates.io/crates/zip/8.1.0
features:
 +default                       = [aes-crypto, bzip2, deflate64, deflate, lzma, ppmd, time, zstd, xz]
  _bzip2_any                    = []
  _deflate-any                  = []
  aes-crypto                    = [dep:aes, dep:constant_time_eq, getrandom/std, dep:hmac, dep:pbkdf2, dep:sha1, dep:zeroize]
  bzip2                         = [dep:bzip2, bzip2/default, _bzip2_any]
  deflate                       = [deflate-zopfli, deflate-flate2-zlib-rs]
  deflate-flate2                = [_deflate-any, dep:flate2]
  deflate-flate2-zlib-rs        = [deflate-flate2, flate2/zlib-rs]
  deflate-zopfli                = [dep:zopfli, _deflate-any]
  deflate64                     = [dep:deflate64]
  lzma                          = [dep:lzma-rust2]
  ppmd                          = [dep:ppmd-rust]
  time                          = [dep:time]
  xz                            = [dep:lzma-rust2]
  zstd                          = [dep:zstd]
  _arbitrary                    = [dep:arbitrary]
  bitstream-io                  = [dep:bitstream-io]
  bzip2-rs                      = [dep:bzip2, bzip2/bzip2-sys, _bzip2_any]
  chrono                        = [dep:chrono]
  deflate-flate2-zlib           = [deflate-flate2, flate2/zlib]
  deflate-flate2-zlib-ng        = [deflate-flate2, flate2/zlib-ng]
  deflate-flate2-zlib-ng-compat = [deflate-flate2, flate2/zlib-ng-compat]
  deprecated-time               = []
  getrandom                     = [dep:getrandom]
  jiff-02                       = [dep:jiff]
  legacy-zip                    = [bitstream-io]
  nt-time                       = [dep:nt-time]
  unreserved                    = []
