blake3
the BLAKE3 hash function
version: 1.8.5
license: CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception
rust-version: unknown
documentation: https://docs.rs/blake3
repository: https://github.com/BLAKE3-team/BLAKE3
crates.io: https://crates.io/crates/blake3/1.8.5
features:
 +default           = [std]
  std               = [constant_time_eq/std]
  digest            = [dep:digest]
  mmap              = [std, dep:memmap2]
  neon              = []
  no_avx2           = []
  no_avx512         = []
  no_neon           = []
  no_sse2           = []
  no_sse41          = []
  prefer_intrinsics = []
  pure              = []
  rayon             = [dep:rayon-core]
  serde             = [dep:serde]
  traits-preview    = [dep:digest]
  wasm32_simd       = []
  zeroize           = [dep:zeroize, arrayvec/zeroize]
sha2 #sha2 #hash #digest
Pure Rust implementation of the SHA-2 hash function family
including SHA-224, SHA-256, SHA-384, and SHA-512.
version: 0.11.0
license: MIT OR Apache-2.0
rust-version: 1.85
documentation: https://docs.rs/sha2
repository: https://github.com/RustCrypto/hashes
crates.io: https://crates.io/crates/sha2/0.11.0
features:
 +default = [alloc, oid]
  alloc   = [digest/alloc]
  oid     = [digest/oid]
  zeroize = [digest/zeroize]
clap #argument #cli #arg #parser #parse
A simple to use, efficient, and full-featured Command Line Argument Parser
version: 4.6.5
license: MIT OR Apache-2.0
rust-version: 1.85
documentation: https://docs.rs/clap/4.6.5
repository: https://github.com/clap-rs/clap
crates.io: https://crates.io/crates/clap/4.6.5
features:
 +default                  = [std, color, help, usage, error-context, suggestions]
  color                    = [clap_builder/color]
  error-context            = [clap_builder/error-context]
  help                     = [clap_builder/help]
  std                      = [clap_builder/std]
  suggestions              = [clap_builder/suggestions]
  usage                    = [clap_builder/usage]
  cargo                    = [clap_builder/cargo]
  debug                    = [clap_builder/debug, clap_derive?/debug]
  deprecated               = [clap_builder/deprecated, clap_derive?/deprecated]
  derive                   = [dep:clap_derive]
  env                      = [clap_builder/env]
  string                   = [clap_builder/string]
  unicode                  = [clap_builder/unicode]
  unstable-derive-ui-tests = []
  unstable-doc             = [clap_builder/unstable-doc, derive]
  unstable-ext             = [clap_builder/unstable-ext]
  unstable-markdown        = [clap_derive/unstable-markdown]
  unstable-styles          = [clap_builder/unstable-styles]
  unstable-v5              = [clap_builder/unstable-v5, clap_derive?/unstable-v5, deprecated]
  wrap_help                = [clap_builder/wrap_help]
cargo-audit #cargo-subcommand #security #audit #vulnerability
Audit Cargo.lock for crates with security vulnerabilities
version: 0.22.2
license: Apache-2.0 OR MIT
rust-version: 1.88
documentation: https://docs.rs/cargo-audit/0.22.2
homepage: https://rustsec.org
repository: https://github.com/rustsec/rustsec
crates.io: https://crates.io/crates/cargo-audit/0.22.2
features:
 +default         = [binary-scanning]
  binary-scanning = [rustsec/binary-scanning, dep:object, dep:rustc-demangle, dep:syn]
  fix             = []
